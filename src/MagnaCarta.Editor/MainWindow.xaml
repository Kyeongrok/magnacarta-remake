<Window x:Class="MagnaCarta.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="마그나카르타 패치판 개발도구" Width="420" Height="300" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="개발도구" FontSize="18" FontWeight="Bold" Margin="4,0,4,12" />
        <Button Content="컷씬 카메라 (fld 카메라 컷 — 속도 · 부드럽게 · 시야각)" Click="OpenCutscene" HorizontalContentAlignment="Left" />
        <Button Content="필드 사건 보기 (조건 · 명령 · 인자, 읽기 전용)" Click="OpenEvents" HorizontalContentAlignment="Left" />
        <Button Content="게임 실행" Click="RunGame" HorizontalContentAlignment="Left" />
        <TextBlock x:Name="Info" Margin="4,16,4,0" TextWrapping="Wrap" Foreground="Gray" />
    </StackPanel>
</Window>
