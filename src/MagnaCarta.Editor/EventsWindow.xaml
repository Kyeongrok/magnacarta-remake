<Window x:Class="MagnaCarta.Editor.EventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="필드 사건 보기" Width="1200" Height="780" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Left" Width="260" Margin="0,0,8,0">
            <TextBox x:Name="Filter" DockPanel.Dock="Top" Margin="0,0,0,4" TextChanged="FilterChanged" ToolTip="필드 번호·장소 이름으로 거르기" />
            <TextBlock x:Name="FieldCount" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,4" Text="필드 읽는 중…" />
            <ListBox x:Name="Fields" SelectionChanged="FieldChanged" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Left" Width="300" Margin="0,0,8,0">
            <TextBlock x:Name="FieldTitle" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4" Text="필드를 고르세요" TextWrapping="Wrap" />
            <Button DockPanel.Dock="Bottom" Content="이 필드로 게임 띄우기" Click="RunField" Margin="0,6,0,0" />
            <ListBox x:Name="Events" FontFamily="Consolas" SelectionChanged="EventChanged" />
        </DockPanel>
        <DockPanel>
            <TextBlock x:Name="EventTitle" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBox x:Name="Body" FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </DockPanel>
    </DockPanel>
</Window>
