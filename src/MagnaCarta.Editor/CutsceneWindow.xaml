<Window x:Class="MagnaCarta.Editor.CutsceneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="컷씬 카메라" Width="1200" Height="780" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <!-- 왼쪽: 필드 · 컷 목록 -->
        <DockPanel DockPanel.Dock="Left" Width="300" Margin="0,0,8,0">
            <TextBox x:Name="Filter" DockPanel.Dock="Top" Margin="0,0,0,4" TextChanged="FilterChanged" ToolTip="필드 번호·장소 이름으로 거르기" />
            <TextBlock x:Name="FieldCount" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,4" Text="필드 읽는 중…" />
            <ListBox x:Name="Cuts" DockPanel.Dock="Bottom" Height="220" SelectionChanged="CutChanged" />
            <TextBlock DockPanel.Dock="Bottom" Text="컷" FontWeight="Bold" Margin="0,8,0,2" />
            <ListBox x:Name="Fields" SelectionChanged="FieldChanged" />
        </DockPanel>
        <!-- 오른쪽: 조정 -->
        <StackPanel DockPanel.Dock="Right" Width="300" Margin="8,0,0,0">
            <TextBlock x:Name="CutTitle" FontSize="16" FontWeight="Bold" Text="컷을 고르세요" TextWrapping="Wrap" />
            <TextBlock x:Name="CutInfo" Foreground="Gray" Margin="0,4,0,12" TextWrapping="Wrap" />

            <TextBlock Text="재생 속도" FontWeight="Bold" />
            <DockPanel><TextBlock x:Name="SpeedText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="Speed" Minimum="0.1" Maximum="4" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="TuneChanged" /></DockPanel>
            <TextBlock Text="부드럽게 (키 이동 평균)" FontWeight="Bold" Margin="0,8,0,0" />
            <DockPanel><TextBlock x:Name="SmoothText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="Smooth" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="TuneChanged" /></DockPanel>
            <TextBlock Text="시야각 (0 = 원본)" FontWeight="Bold" Margin="0,8,0,0" />
            <DockPanel><TextBlock x:Name="FovText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="Fov" Minimum="0" Maximum="120" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="TuneChanged" /></DockPanel>

            <WrapPanel Margin="0,12,0,0">
                <Button Content="저장" Click="Save" />
                <Button Content="원래대로" Click="Reset" />
                <Button Content="게임에서 보기" Click="Preview" ToolTip="그 필드로 게임을 띄워 이 컷을 바로 틀고 F7 조정 창을 연다" />
            </WrapPanel>
            <TextBlock x:Name="SaveInfo" Foreground="Gray" TextWrapping="Wrap" Margin="4,8,0,0" />
            <TextBlock Margin="4,16,0,0" Foreground="Gray" TextWrapping="Wrap"
                       Text="원본 파일은 그대로 두고 %LOCALAPPDATA%\MagnaCartaPatch\cuts.txt 에 덮어쓸 값을 적는다(게임 F7 창과 같은 파일). 게임은 켤 때 읽는다." />
        </StackPanel>
        <!-- 가운데: 위에서 본 카메라 길 + 틀 막대 -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Content="재생" Click="Play" Width="70" />
                <TextBlock x:Name="TickText" DockPanel.Dock="Right" Width="110" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider x:Name="Tick" Minimum="0" Maximum="1" VerticalAlignment="Center" ValueChanged="TickChanged" />
            </DockPanel>
            <TextBlock x:Name="KeyInfo" DockPanel.Dock="Bottom" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
            <Border BorderBrush="#888" BorderThickness="1" Background="#1b1b1f">
                <Canvas x:Name="Plot" ClipToBounds="True" SizeChanged="PlotSizeChanged" />
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
